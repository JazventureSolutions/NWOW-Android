<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".utils.NwowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nwow"
        tools:targetApi="31">
        <activity
            android:name=".ui.splash.SplashActivity"
            android:theme="@style/Theme.Nwow"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.login.LoginActivity"
            android:theme="@style/Theme.Nwow"
            android:exported="false" />
        <activity
            android:name=".ui.changepassword.ChangePasswordActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".ui.auth.TotpSetupActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".ui.auth.TotpChallengeActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".ui.auth.TotpResetActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".ui.main.MainActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
        <activity
            android:name=".ui.manage.AdminUsersActivity"
            android:theme="@style/Theme.Nwow"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />
    </application>

</manifest>